NODE_ENV=development
HOST=0.0.0.0
PORT=3001
MONGODB_URI=mongodb://localhost:27017/ai-marketing-platform
MONGODB_DATABASE=
MONGODB_DATABASE_PREFIX=ai_marketing
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
TRUST_PROXY=false
AUTH_ISSUER=ai-marketing-platform
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_COOKIE_SECURE=false
AUTH_RESET_REVOKES_ALL_SESSIONS=true
STORAGE_PUBLIC_URL=http://localhost:3001/files
AI_PROVIDER=disabled
INTEGRATIONS_WEBHOOK_BASE_URL=http://localhost:3001/api/v1/integrations/webhooks
