VITE_API_URL=http://localhost:3001
# Enable exactly one development provider: openai, gemini, groq, openrouter, or ollama.
AI_PROVIDER=ollama
AI_ALLOWED_PROVIDERS=ollama
AI_TIMEOUT_MS=30000
AI_MONTHLY_TOKEN_QUOTA=1000000
AI_MONTHLY_COST_QUOTA_USD=100
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GROQ_API_KEY=
GROQ_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
ATLAS_VECTOR_INDEX_VERSION=v1
ATLAS_VECTOR_CANDIDATE_VERSION=
ATLAS_VECTOR_DUAL_READ=false
APP_MAX_BODY_SIZE_BYTES=1048576
STORAGE_MAX_FILE_SIZE_BYTES=52428800
TRUST_PROXY=false
# Require this bearer token on the Prometheus scrape endpoint in shared environments.
METRICS_BEARER_TOKEN=

# Meta
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
META_REDIRECT_URI=
# Public API origin/prefix used to construct provider webhook callback URLs.
INTEGRATIONS_WEBHOOK_BASE_URL=http://localhost:3001/api/v1

# GoHighLevel
HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
HIGHLEVEL_REDIRECT_URI=
# Optional: official webhook verification public key; leave empty until configured.
HIGHLEVEL_WEBHOOK_PUBLIC_KEY=
# Optional provider endpoint override. Keep the official HTTPS endpoint unless testing against an approved mock.
HIGHLEVEL_API_BASE_URL=https://services.leadconnectorhq.com
