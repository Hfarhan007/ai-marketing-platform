NODE_ENV=development
HOST=0.0.0.0
PORT=3001
MONGODB_URI=mongodb://mongodb:27017/ai_marketing_development?replicaSet=rs0
MONGODB_DATABASE=ai_marketing_development
REDIS_URL=redis://redis:6379
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
AUTH_ISSUER=ai-marketing-platform-local
AUTH_ACCESS_TOKEN_SECRET=development-only-access-token-secret-change-before-production
AUTH_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AUTH_COOKIE_SECURE=false
STORAGE_PROVIDER=r2
STORAGE_BUCKET=amp-development
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000/amp-development
INTEGRATIONS_WEBHOOK_BASE_URL=http://localhost:3001/api/v1
AI_PROVIDER=disabled
AI_ALLOWED_PROVIDERS=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LOG_LEVEL=debug

# Meta — configure through a local uncommitted override when integration testing.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
META_REDIRECT_URI=

# GoHighLevel — configure through a local uncommitted override when integration testing.
HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
HIGHLEVEL_REDIRECT_URI=
HIGHLEVEL_WEBHOOK_PUBLIC_KEY=
HIGHLEVEL_API_BASE_URL=https://services.leadconnectorhq.com
