FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @repo/worker build

FROM node:22-alpine
RUN corepack enable
WORKDIR /workspace
ENV NODE_ENV=production
COPY --from=build /workspace /workspace
USER node
EXPOSE 3002
CMD ["node", "apps/worker/dist/index.js"]
